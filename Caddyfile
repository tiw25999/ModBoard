# Internal reverse proxy that load-balances between app1 + app2.
# Caddy actively health-checks each upstream and pulls a node out of
# rotation the moment its /health stops returning 2xx — that's what
# makes the rolling deploy 0-downtime.

{
	admin off
	auto_https off
}

:8000 {
	log {
		output stdout
		format console
		level INFO
	}

	# Trust the X-Forwarded-* headers from cloudflared so the app
	# sees the real client IP, not the tunnel's internal IP.
	# (cloudflared also injects CF-Connecting-IP — that's the
	# authoritative one if you want it in your audit log.)

	reverse_proxy app1:8000 app2:8000 {
		# round_robin (default) — both serve traffic when healthy.
		# During rolling restart, the unhealthy one is bypassed.
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms

		# Active health probe — pulls upstream out of rotation
		# within ~3s of /health failing.
		health_uri /health
		health_interval 3s
		health_timeout 2s
		health_status 2xx

		# Passive — if an upstream returns 5xx, stop sending it
		# requests for 30s.
		fail_duration 30s
		max_fails 2
		unhealthy_status 5xx

		# Don't hang on a stuck backend.
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}

		# Pass real client IP through to the app.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Health endpoint exposed by caddy itself — lets deploy.sh
	# probe the proxy without needing an app upstream.
	handle /caddy-health {
		respond "ok" 200
	}
}
