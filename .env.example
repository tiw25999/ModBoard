# App
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=tiw25
ADMIN_PASSWORD=change-me

# Database
POSTGRES_USER=modboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=modboard
DATABASE_URL=postgresql+asyncpg://modboard:change-me@db:5432/modboard

# Steam (creator SteamID64 from your profile URL — used in comment AJAX URL)
STEAM_CREATOR_ID=76561198279237042
POLL_INTERVAL_MINUTES=30

# Steam Web API key (optional but strongly recommended — without it, the
# legacy unauthenticated endpoint sometimes returns null subs/favs/views).
# Get one at https://steamcommunity.com/dev/apikey (free; requires a
# Steam account with ≥$5 lifetime spend). 100k requests/day quota.
STEAM_WEB_API_KEY=

# Cloudflare Tunnel (token from Cloudflare Zero Trust dashboard)
CLOUDFLARED_TOKEN=

# Google OAuth (optional — leave empty to disable Sign in with Google)
# Create at https://console.cloud.google.com/auth/clients
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Production toggle — when true, all auth cookies set Secure flag (HTTPS only).
# Set to true on any tunnel-backed / HTTPS deploy. Leave false for local dev.
PRODUCTION=false

# Canonical public URL — used to build absolute links in RSS feeds, sitemap,
# and JSON-LD. Prevents host-header cache poisoning. Leave blank to fall
# back to the incoming request's host.
CANONICAL_BASE=

# Stripe — required for membership payments.
# Use sk_test_... / whsec_test_... for local dev (test mode), sk_live_... for prod.
# Get keys at https://dashboard.stripe.com/apikeys
# Get webhook secret at https://dashboard.stripe.com/webhooks (event: checkout.session.completed)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
